# NetBox + Diode ingestion plugin (NetBox Discovery eval)
# Build/push (amd64 only — netbox pods are arch-pinned):
#   podman build --platform linux/amd64 -f k8s/netbox/Dockerfile.diode \
#     -t ghcr.io/lothriell/netbox-diode:v4.7.3-plugin1.18.1 k8s/netbox
#   podman push ghcr.io/lothriell/netbox-diode:v4.7.3-plugin1.18.1
# Plugin↔NetBox version matrix: https://github.com/netboxlabs/diode-netbox-plugin
# (plugin >= 1.17.0 for NetBox 4.7.x).
FROM ghcr.io/netbox-community/netbox:v4.7.3
# The image's venv (/opt/netbox/venv, already on PATH) is uv-built and ships
# without pip or ensurepip — install with a borrowed uv binary instead.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
# PyJWT < 2.14.0 = CVE-2026-102268 (critical, Trivy 2026-10-16). A floor, not a
# pin: keeps whatever the base ships if it is already newer.
RUN uv pip install --python /opt/netbox/venv/bin/python3 --no-cache \
      netboxlabs-diode-netbox-plugin==1.18.1 \
      "PyJWT>=2.14.0" \
 && rm /usr/local/bin/uv
# (The -patch1 counter_buffer `using` kwarg sed fix for plugin 1.16.0 is gone:
# 1.18.x ships `_buffered_update_counter(..., using=None, **kwargs)` upstream.)
