---
# Helm values for argo/argocd-image-updater.
#
# Copy to `values-image-updater.yml` (gitignored) with real credentials
# and install:
#   cp k8s/argocd/values-image-updater.yml.example \
#      k8s/argocd/values-image-updater.yml
#   # edit the prefix + GITEA_CREDS
#   helm upgrade --install argocd-image-updater argo/argocd-image-updater \
#     -n argocd -f k8s/argocd/values-image-updater.yml --wait

nodeSelector:
  kubernetes.io/arch: arm64

resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    cpu: 200m
    memory: 128Mi

extraEnv:
  # GitHub username + classic PAT with read:packages, used by Image
  # Updater to poll ghcr.io for new digests. Same token as vault
  # `ghcr_token` (DR-3 registry decoupling).
  # TODO CHANGEME
  - name: GHCR_CREDS
    value: "GITHUB_USERNAME:GHCR_PAT"
  # Username + Gitea API token for the legacy in-cluster registry
  # (deprecated for new pushes since DR-3). Generate a token at
  # `http://gitea.<local-domain>/-/user/settings/applications` with
  # `read:package` scope.
  # TODO CHANGEME
  - name: GITEA_CREDS
    value: "USERNAME:GITEA_API_TOKEN"

config:
  registries:
    # ghcr.io — primary registry since DR-3: images survive cluster
    # nuke, standard public TLS (no internal CA involvement).
    - name: GitHub
      prefix: ghcr.io
      api_url: https://ghcr.io
      default: true
      credentials: env:GHCR_CREDS
    # Gitea in-cluster registry — deprecated for new pushes, kept while
    # old images remain referenced.
    - name: Gitea
      # TODO CHANGEME — must match the registry prefix used in your
      # ImageUpdater CRDs (see eve-tracker-image-updater.yml.example)
      prefix: gitea.example.local
      # In-cluster access via the Gitea service. Image Updater runs in
      # the argocd namespace and resolves the service DNS directly —
      # no ingress / LoadBalancer needed.
      api_url: http://gitea-http.gitea.svc.cluster.local:3000
      insecure: true
      credentials: env:GITEA_CREDS

  argocd:
    plaintext: true
    insecure: true
