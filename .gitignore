# NOTE: private planning docs/runbooks (improvement-plan.md, ops-commands.md,
# 18-architecture.md, 13-deploy-eve-tracker-dev.md, eve-tracker-deployment.md, pipeline/)
# are NO LONGER gitignored — they are committed to the private origin and listed in
# .publicignore, which strips them from the public mirror (scripts/publish-public.sh).
# Only true secrets + real-value config stay below.

# Private secrets with real IPs/secrets
k8s/eve-tracker/secret.yml
k8s/eve-tracker/overlays/*/secret.yml
k8s/argocd/values-image-updater.yml
k8s/argocd/eve-tracker-image-updater.yml
k8s/argocd/eve-tracker-dev-image-updater.yml

# Local Ingress overrides (so private hostnames don't leak to public repo)
k8s/*/ingress.local.yml

# Helm values that embed the real local_domain
k8s/trivy/values-trivy-operator.yml
k8s/vaultwarden/values-vaultwarden.yml

*.sync-conflict-*

# Personal scratch notes (not for public)
ipad.md
scripts/eve-tracker-cutover.sh

# Helm values + ArgoCD app manifests with real domains/IPs.
# Use the .example variants as a template; copy + edit before deploy.
k8s/argocd/values-argocd.yml
k8s/argocd/eve-tracker-test-app.yml
k8s/monitoring/values-grafana.yml
