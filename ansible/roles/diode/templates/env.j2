# {{ ansible_managed }} — ansible/roles/diode (vault-backed secrets)
DIODE_NGINX_PORT={{ diode_nginx_port }}
REDIS_PASSWORD={{ diode_redis_password }}
REDIS_HOST=redis
REDIS_PORT=6378
REDIS_USERNAME=
LOGGING_LEVEL={{ diode_logging_level }}
SENTRY_DSN=
MIGRATION_ENABLED=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ diode_postgres_password }}
DIODE_POSTGRES_DB_NAME=diode
DIODE_POSTGRES_USER=diode
DIODE_POSTGRES_PASSWORD={{ diode_db_password }}
TELEMETRY_ENVIRONMENT=dev
TELEMETRY_METRICS_EXPORTER=prometheus
TELEMETRY_TRACES_EXPORTER=none
HYDRA_POSTGRES_DB_NAME=hydra
HYDRA_POSTGRES_USER=hydra
HYDRA_POSTGRES_PASSWORD={{ diode_hydra_db_password }}
HYDRA_STRATEGIES_ACCESS_TOKEN=jwt
HYDRA_STRATEGIES_REFRESH_TOKEN=jwt
HYDRA_STRATEGIES_JWT_SCOPE_CLAIM=both
HYDRA_TTL_ACCESS_TOKEN=1h
HYDRA_OIDC_SUBJECT_IDENTIFIERS_SUPPORTED_TYPES=public
HYDRA_URLS_SELF_ISSUER=http://127.0.0.1:4444
HYDRA_SECRETS_SYSTEM_0={{ diode_hydra_secrets_system }}
AUTH_HTTP_PORT=8080
OAUTH2_PUBLIC_SERVER_URL=http://hydra:4444
OAUTH2_ADMIN_SERVER_URL=http://hydra:4445
DIODE_AUTH_TOKEN_URL=http://diode-auth:8080/token
DIODE_TO_NETBOX_CLIENT_ID=diode-to-netbox
DIODE_TO_NETBOX_CLIENT_SECRET={{ diode_to_netbox_client_secret }}
DIODE_TO_NETBOX_RATE_LIMITER_RPS={{ diode_to_netbox_rate_limiter_rps }}
DIODE_TO_NETBOX_RATE_LIMITER_BURST={{ diode_to_netbox_rate_limiter_burst }}
NETBOX_DIODE_PLUGIN_API_BASE_URL={{ diode_netbox_api_base_url }}
NETBOX_DIODE_PLUGIN_API_TIMEOUT_SECONDS={{ diode_netbox_api_timeout_seconds }}
NETBOX_DIODE_PLUGIN_SKIP_TLS_VERIFY=false
ENABLE_GRAPH_DB=false
INGESTION_LOG_PROCESSOR_BATCH_SIZE={{ diode_batch_size }}
INGESTION_LOG_PROCESSOR_CONCURRENCY={{ diode_concurrency }}
AUTO_APPLY_PROCESSOR_BATCH_SIZE={{ diode_batch_size }}
AUTO_APPLY_PROCESSOR_CONCURRENCY={{ diode_concurrency }}
INGESTION_LOG_PROCESSOR_BACKPRESSURE_THRESHOLD=100
DIODE_TAG={{ diode_tag }}
