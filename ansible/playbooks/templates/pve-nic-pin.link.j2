# Managed by Ansible (81-upgrade-proxmox.yml) — local edits will be overwritten.
# Pins the NIC name by MAC so kernel/systemd upgrades cannot rename it (#85).
# Type=ether keeps the match off vmbr0, which carries the uplink's MAC.
[Match]
MACAddress={{ item.mac }}
Type=ether

[Link]
Name={{ item.name }}
