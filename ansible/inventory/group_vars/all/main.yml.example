---
# Non-secret cluster configuration — copy to main.yml (gitignored) and fill in.
#
# Secrets live in a separate vault.yml in this same directory, encrypted with
# Ansible Vault. See vault.yml.example for the secret schema.

# Personal user account (used for bootstrap and cloud-init)
personal_user: myuser

# SSH public key (used in cloud-init for both personal and ansible users)
ssh_pubkey: "ssh-ed25519 AAAA... your-key-here"

# Node IPs — must match your network/DHCP reservations
node_ip_1: 10.0.0.11
node_ip_2: 10.0.0.12
node_ip_3: 10.0.0.13
node_ip_4: 10.0.0.14

# K3s HA control plane VIP (kube-vip ARP mode).
# Pick an IP in the cluster subnet that's outside the MetalLB pool and not
# assigned to any node. This is what kubectl, agents, and ArgoCD connect to.
k3s_api_vip: 10.0.0.10
k3s_api_url: "https://{{ k3s_api_vip }}:6443"

# Legacy alias — kept for out-of-cluster consumers that hit a NodePort on a
# specific Pi (e.g. Promtail → Loki NodePort 31100). NodePort routing is
# node-local, so these need a concrete node IP, not the VIP.
k3s_server_ip: "{{ node_ip_1 }}"
k3s_server_url: "{{ k3s_api_url }}"

# MetalLB IP range for LoadBalancer services
metallb_ip_range: "10.0.0.100-10.0.0.110"

# Tailscale (auth key lives in vault.yml)
tailscale_subnet_routes: "10.0.0.0/24"

# x86 K3s agent node IPs (Proxmox VMs)
x86_node_ip_1: 10.0.0.21
x86_node_ip_2: 10.0.0.22

# SFF node IPs
sff_athena_ip: 10.0.0.30

# Display/infotainment nodes
display_rpizerow_ip: 10.0.0.60
sff_artemis_ip: 10.0.0.31
sff_minisforum_ip: 10.0.0.32

# GPU server IP
# (gpu_node_ip_1 removed 2026-07-24 — the GPU box IS minisforum-c / sff_minisforum_ip)

# Wazuh manager IP
wazuh_manager_ip: 10.0.0.50

# Local domain (used for Gitea registry hostname, etc.)
local_domain: yourdomain.local

# System timezone applied to all nodes by the common role. Default: UTC.
# Any IANA tz name (e.g. "Europe/Prague", "America/New_York", "UTC").
timezone: "UTC"

# Desktop/laptop Tailscale IPs
tailscale_arch_t_01: 100.x.x.x
tailscale_cachy_t_01: 100.x.x.x
tailscale_loki: 100.x.x.x
tailscale_macmini: 100.x.x.x
tailscale_wazuh_server: 100.x.x.x
tailscale_thorwsl: 100.64.0.15
# Fleet tailnet IPs for the distributed ssh aliases (00-setup-ssh-aliases.yml)
tailscale_rpi1: 100.64.0.11
tailscale_rpi2: 100.64.0.12
tailscale_rpi3: 100.64.0.13
tailscale_rpi4: 100.64.0.14
tailscale_minisforum: 100.64.0.20
tailscale_x86_1: 100.64.0.21
tailscale_x86_2: 100.64.0.22
tailscale_athena: 100.64.0.30
tailscale_artemis: 100.64.0.31
# LAN IPs used only by the ssh-alias template
macmini_lan_ip: 10.0.0.12
pve_lan_ip: 10.0.0.10
desktop_arch_t_lan_ip: 10.0.0.50
desktop_cachy_t_lan_ip: 10.0.0.51
desktop_loki_lan_ip: 10.0.0.94         # Dell laptop (Omarchy/Arch), home LAN

# Cloudflare tunnel domain
cloudflare_domain: example.com

# Cloudflare Tunnel — UUID from `cloudflared tunnel create pi-cluster`
# The matching credentials JSON must exist at ~/.cloudflared/<UUID>.json.
cloudflare_tunnel_id: "00000000-0000-0000-0000-000000000000"

# Public-facing ingress rules for the tunnel. Every request to <hostname>
# is proxied to the given in-cluster <service> URL. The playbook appends a
# catch-all http_status:404 automatically.
cloudflare_ingress_rules:
  - hostname: "ntfy.{{ cloudflare_domain }}"
    service: "http://ntfy-external.default.svc.cluster.local:8080"
  - hostname: "dev-app.{{ cloudflare_domain }}"
    service: "http://app-frontend.app-dev-namespace.svc.cluster.local:80"
  # NetBox eval demo — keep behind Cloudflare Access (Zero Trust email OTP).
  - hostname: "netbox.{{ cloudflare_domain }}"
    service: "http://netbox.netbox.svc.cluster.local:80"

# ntfy (public config — credentials in vault.yml)
ntfy_topic: "dns-alerts"
ntfy_base_url: "https://ntfy.yourdomain.com"
ntfy_k8s_alerts_topic: "k8s-alerts"

# Monitoring dead-man's-switch (external watchdog on athena, role
# monitoring-watchdog + playbook 15). Cluster Alertmanager re-POSTs the
# always-firing Watchdog alert here every ~1 min; athena pages via ntfy if the
# heartbeats stop. The host MUST be athena's TAILNET IP — cluster pods route to
# 100.x via the node's tailscaled (same path Prometheus uses to scrape
# Syncthing); a LAN/VLAN IP is less robust across network changes.
watchdog_athena_host: "100.x.y.z"   # athena tailnet IP
watchdog_receiver_port: 8099
watchdog_stale_seconds: 300         # page if no heartbeat for 5 min

# Cloudflare R2 — backup target (credentials in vault.yml)
r2_account_id: "your-cloudflare-account-id"
r2_backup_bucket: "k8sbkp"
r2_endpoint_host: "{{ r2_account_id }}.r2.cloudflarestorage.com"
r2_endpoint_url: "https://{{ r2_endpoint_host }}"

# Backblaze B2 — second backup destination (DR-2). One bucket mirrors the whole
# R2 bucket 1:1 (prefixes longhorn/ + k3s-etcd-snapshots/). Create it in the B2
# UI WITH Object Lock enabled (cannot be added later); the endpoint/region are
# shown on the bucket page. Keys live in vault.yml (b2_key_id, b2_application_key).
b2_mirror_bucket: "homielab-k8sbkp-mirror"
b2_region: "your-b2-region"                          # e.g. eu-central-003
b2_s3_endpoint: "s3.{{ b2_region }}.backblazeb2.com"

# Syncthing tailnet IPs (each instance binds its GUI to its own tailnet
# address so the cluster Prometheus can scrape /metrics over Tailscale).
# See memory project_syncthing.md for the auto-start strategy per host.
syncthing_macair_tsip: 100.x.x.x
syncthing_macmini_tsip: 100.x.x.x
syncthing_thorwsl_tsip: 100.x.x.x

# Proxmox hypervisor (remote site)
pve_host_ip: 100.64.0.99
# MAC of the pve uplink NIC (vmbr0 bridge port) — used by bridge-selfheal
pve_uplink_mac: "aa:bb:cc:dd:ee:ff"

# NetBox Discovery eval (playbook 24) — custom image with diode plugin
# (k8s/netbox/Dockerfile.diode); diode server = docker compose on the GPU node
netbox_image_repository: "your-ghcr-namespace/netbox-diode"
netbox_image_tag: "v4.6.10-plugin1.16.0"
netbox_diode_target: "grpc://<gpu-node-ip>:8080/diode"
