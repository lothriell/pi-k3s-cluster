<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily off-site backup of ~/.claude to Backblaze B2 (DR-2 scope add).
     Installed by `make claude-backup-install` (sed fills __REPO__/__HOME__).
     Logs: ~/Library/Logs/claude-backup.log (+ launchd stdout/err below). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.homielab.claude-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/claude-memories-backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/claude-backup.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/claude-backup.launchd.log</string>
</dict>
</plist>
